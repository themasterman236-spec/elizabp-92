entity:SetCallback("OnSpawned", function()
	print("Entity has spawned")

	task.spawn(function()
		local success, err = pcall(function()
			local part = workspace:WaitForChild("CC-60", 10)
			local object = part:WaitForChild("HumanoidRootPart", 10)
			local Scrpit = object:WaitForChild("1st", 10)
			object.CanCollide = false

local sin = math.sin
local cos = math.cos
local t = 0

local g = script.Parent.MonsterGui
local g2 = script.Parent.MonsterGui2

while task.wait() do
	t += 1 / 0.7
	g.ExtentsOffsetWorldSpace = Vector3.new(
		sin(t / 20) * cos(t / 50) * 14,
		-sin(t / 20) * cos(t / 50) * 1,
		cos(t / 20) * sin(t / 50) * 25
	)
	g2.ExtentsOffsetWorldSpace = Vector3.new(
		-sin(t / 20) * cos(t / 50) * 14,
		sin(t / 20) * cos(t / 50) * 1,
		-cos(t / 20) * sin(t / 50) * 25
	)
	for i,v in pairs(g:GetChildren()) do
		v.Rotation = cos(t / 20) * sin(t / 50) * 35
	end
	for i,v in pairs(g2:GetChildren()) do
		v.Rotation = -cos(t / 20) * sin(t / 50) * 35
	end
end)

